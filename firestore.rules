rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaffAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "developer.alikend@gmail.com" ||
        request.auth.token.email == "admin234@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Hotlines: public can read active hotlines, only staff can write
    match /hotlines/{hotlineId} {
      allow read: if resource.data.isActive == true || isStaffAdmin();
      allow write: if isStaffAdmin() && isValidId(hotlineId);
    }

    // Support Tickets: users can read and create their own tickets, staff can manage all
    match /supportTickets/{ticketId} {
      allow read: if isStaffAdmin() || (isSignedIn() && resource.data.customerEmail == request.auth.token.email);
      allow create: if isStaffAdmin() || (isSignedIn() && request.resource.data.customerEmail == request.auth.token.email);
      allow update: if isStaffAdmin() || (isSignedIn() && resource.data.customerEmail == request.auth.token.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies', 'updatedAt', 'csatRating', 'csatFeedback']));
      allow delete: if isStaffAdmin();
    }

    // Knowledge Articles / FAQ: public read published articles, staff write
    match /knowledgeArticles/{articleId} {
      allow read: if resource.data.status == "published" || isStaffAdmin();
      allow write: if isStaffAdmin() && isValidId(articleId);
    }

    // Customer Care Global Settings: public read, staff write
    match /customerCareSettings/{settingId} {
      allow read: if true;
      allow write: if isStaffAdmin();
    }
  }
}
